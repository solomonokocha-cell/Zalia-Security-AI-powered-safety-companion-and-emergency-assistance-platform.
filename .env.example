# Zalia Security - Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here

# Flask Configuration
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=True

# Database (if using in the future)
DATABASE_URL=

# Firebase Configuration (if implementing live incidents)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Google Maps API (if using)
GOOGLE_MAPS_API_KEY=

# Email Service (if implementing notifications)
EMAIL_SERVICE_KEY=
EMAIL_FROM_ADDRESS=

# Security
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=localhost:3000,localhost:5000

# Logging
LOG_LEVEL=INFO
